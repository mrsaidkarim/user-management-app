
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  member
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(member)
  salary    Decimal  @db.Decimal(12, 2)
  startDate DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([name])
  @@index([role])
}
